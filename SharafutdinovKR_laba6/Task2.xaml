<Window x:Class="SharafutdinovKR_laba6.Task2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SharafutdinovKR_laba6"
        mc:Ignorable="d"
        Title="Task2" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Введите целое неотрицательное число:"/>
            <TextBox x:Name="InputTextBox" Margin="0,5,0,0" Padding="5"/>
        </StackPanel>

        <Button x:Name="CalculateButton" 
                Grid.Row="1" 
                Content="Подсчитать цифры" 
                Click="CalculateButton_Click"
                Margin="0,0,0,10" 
                Padding="10,5"/>

        <StackPanel Grid.Row="2">
            <Label Content="Результат:" FontWeight="Bold"/>
            <TextBlock x:Name="ResultTextBlock" 
                       Margin="10,0,0,10" 
                       FontSize="16" 
                       Foreground="Blue"/>

            <Label Content="Детали вычислений:" FontWeight="Bold"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="200">
                <TextBlock x:Name="DetailsTextBlock" 
                           Margin="10,0,0,0" 
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>

        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="Готов к работе"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
