<Window x:Class="SharafutdinovKR_laba6.Task5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SharafutdinovKR_laba6"
        mc:Ignorable="d"
        Title="Task5" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель ввода -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Строки:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="RowsTextBox" Width="50" Text="3" Margin="5"/>
            <TextBlock Text="Столбцы:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="ColsTextBox" Width="50" Text="4" Margin="5"/>
            <Button x:Name="GenerateButton" Content="Создать" Width="80" Margin="5" Click="GenerateButton_Click"/>
            <Button x:Name="RotateButton" Content="Повернуть" Width="80" Margin="5" IsEnabled="False" Click="RotateButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="InfoTextBlock" Grid.Row="1" Margin="5" FontWeight="Bold"/>

        <GroupBox Grid.Row="2" Header="Исходная матрица" Margin="0,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="OriginalMatrixGrid" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True"/>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Повернутая матрица (90°)" Margin="0,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="RotatedMatrixGrid" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
