<Window x:Class="SharafutdinovKR_laba6.Task4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SharafutdinovKR_laba6"
        mc:Ignorable="d"
        Title="Task4" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Обработка квадратной матрицы порядка 12" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,15"
                   Foreground="#2C3E50"/>

        <Border Grid.Row="1" 
                Background="#F0F0F0" 
                CornerRadius="5" 
                Padding="10" 
                Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">

                <TextBlock Text="Размер матрицы:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"
                           FontSize="14"/>

                <TextBox x:Name="RowsTextBox" 
                         Width="50" 
                         Text="12" 
                         IsEnabled="False"
                         TextAlignment="Center"
                         Margin="0,0,5,0"/>

                <TextBlock Text="x" 
                           VerticalAlignment="Center" 
                           Margin="0,0,5,0"
                           FontSize="16"
                           FontWeight="Bold"/>

                <TextBox x:Name="ColsTextBox" 
                         Width="50" 
                         Text="12" 
                         IsEnabled="False"
                         TextAlignment="Center"
                         Margin="0,0,20,0"/>

                <Button x:Name="GenerateButton" 
                        Content="Сгенерировать матрицу" 
                        Background="#3498DB"
                        Foreground="White"
                        Click="GenerateButton_Click"/>

                <Button x:Name="ProcessButton" 
                        Content="Обработать матрицу" 
                        Background="#27AE60"
                        Foreground="White"
                        IsEnabled="False"
                        Click="ProcessButton_Click"/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2" 
                  Header="Исходная матрица"
                  BorderBrush="#3498DB"
                  BorderThickness="2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="OriginalMatrixGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ строки" 
                                          Binding="{Binding RowNumber}" 
                                          Width="80"
                                          FontWeight="Bold"/>
                        <DataGridTextColumn Header="Колонка 1" 
                                          Binding="{Binding ColumnValues[0], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 2" 
                                          Binding="{Binding ColumnValues[1], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 3" 
                                          Binding="{Binding ColumnValues[2], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 4" 
                                          Binding="{Binding ColumnValues[3], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 5" 
                                          Binding="{Binding ColumnValues[4], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 6" 
                                          Binding="{Binding ColumnValues[5], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 7" 
                                          Binding="{Binding ColumnValues[6], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 8" 
                                          Binding="{Binding ColumnValues[7], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 9" 
                                          Binding="{Binding ColumnValues[8], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 10" 
                                          Binding="{Binding ColumnValues[9], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 11" 
                                          Binding="{Binding ColumnValues[10], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 12" 
                                          Binding="{Binding ColumnValues[11], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </GroupBox>

        <Border Grid.Row="3" 
                Background="#E8F4FD" 
                CornerRadius="5" 
                Padding="10" 
                Margin="0,15">
            <TextBlock x:Name="InfoTextBlock" 
                       Text="Сгенерируйте матрицу для начала работы" 
                       HorizontalAlignment="Center" 
                       Foreground="#2C3E50"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Border>

        <GroupBox Grid.Row="4" 
                  Header="Результирующая матрица"
                  BorderBrush="#27AE60"
                  BorderThickness="2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="ResultMatrixGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ строки" 
                                          Binding="{Binding RowNumber}" 
                                          Width="80"
                                          FontWeight="Bold"/>
                        <DataGridTextColumn Header="Колонка 1" 
                                          Binding="{Binding ColumnValues[0], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 2" 
                                          Binding="{Binding ColumnValues[1], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 3" 
                                          Binding="{Binding ColumnValues[2], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 4" 
                                          Binding="{Binding ColumnValues[3], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 5" 
                                          Binding="{Binding ColumnValues[4], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 6" 
                                          Binding="{Binding ColumnValues[5], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 7" 
                                          Binding="{Binding ColumnValues[6], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 8" 
                                          Binding="{Binding ColumnValues[7], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 9" 
                                          Binding="{Binding ColumnValues[8], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 10" 
                                          Binding="{Binding ColumnValues[9], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 11" 
                                          Binding="{Binding ColumnValues[10], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                        <DataGridTextColumn Header="Колонка 12" 
                                          Binding="{Binding ColumnValues[11], StringFormat={}{0:F2}}" 
                                          Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
